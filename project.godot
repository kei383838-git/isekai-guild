; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="異世界の不思議な冒険ギルド"
run/main_scene="res://scenes/ui/TitleScreen.tscn"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://icon.svg"

[autoload]

TurnManager="*res://scripts/systems/TurnManager.gd"
LogManager="*res://scripts/systems/LogManager.gd"
QuestManager="*res://scripts/systems/QuestManager.gd"
LevelTable="*res://scripts/systems/LevelTable.gd"
Combat="*res://scripts/systems/Combat.gd"
PlayerData="*res://scripts/systems/PlayerData.gd"
PauseMenu="*res://scenes/ui/PauseMenu.tscn"
KeyHelpOverlay="*res://scenes/ui/KeyHelpOverlay.tscn"
DebugInput="*res://scripts/systems/DebugInput.gd"
SaveManager="*res://scripts/systems/SaveManager.gd"
SettingsManager="*res://scripts/systems/SettingsManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[dotnet]

project/assembly_name="異世界の不思議な冒険ギルド"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

[rendering]

renderer/rendering_method="mobile"
